# --- PlatformIO / editor (as generated) ---
.pio
.cache
.dummy
compile_commands.json

# --- editor and tool settings: personal, not part of the project ---
.vscode/
.idea/
.claude/*
!.claude/skills/
!.claude/skills/**
*.local.json
*.local.md

# --- build output (build.ps1, the engine tests, ui_dump) ---
build/
*.o
*.obj
*.d
*.exe
*.dll
*.pdb
*.map

# --- third-party libraries: cloned separately, not versioned (see DEVELOPING.md, "Requirements") ---
lib/

# --- audio: the simulator's sample card folder. Demo files are generated by tools/make_demo_samples.py; anything else
#     in there is the user's own audio (possibly not redistributable), so none of it is committed ---
samples/
sdcard/
*.wav
*.mp3
*.flac
*.ogg
*.smp

# --- debugging captures and scratch files ---
*.bmp
*.log
/run*.txt
*.tmp
*.bak
*.orig
__pycache__/
*.pyc
.DS_Store
Thumbs.db
desktop.ini

# --- secrets, in case any ever land in the folder ---
.env
.env.*
*.key
*.pem
*.pfx
secrets*
