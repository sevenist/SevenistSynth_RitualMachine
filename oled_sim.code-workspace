// Open this file in VS Code (File > Open Workspace from File): the repo, and every app as a folder of its own, because the
// PlatformIO extension builds and flashes the folder that holds a platformio.ini (pick the app in its status bar).
// tools/new_project.ps1 adds a new app after the template's two lines.
{
    "folders": [
        { "name": "oled_sim", "path": "." },
        { "name": "ritual_machine", "path": "apps/ritual_machine" },
        { "name": "template", "path": "apps/template" },
        { "name": "technogen", "path": "apps/technogen" },
        { "name": "HWV2_scanner", "path": "apps/HWV2_scanner" }
    ],
    "settings": {
        // An app is open twice (inside the repo and as its own folder): the repo's search leaves it to the app's folder.
        "search.exclude": {
            "apps/ritual_machine": true,
            "apps/template": true,
            "apps/technogen": true,
            "apps/HWV2_scanner": true
        }
    },
    "extensions": {
        "recommendations": ["pioarduino.pioarduino-ide"]
    },
    // Terminal > Run Task: the firmware from the repo root (upload.ps1: the board found on USB), the simulator.
    "tasks": {
        "version": "2.0.0",
        "tasks": [
            {
                "label": "Firmware: upload (Ritual Machine)",
                "type": "shell",
                "command": "powershell",
                "args": [
                    "-NoProfile",
                    "-ExecutionPolicy",
                    "Bypass",
                    "-File",
                    "${workspaceFolder:oled_sim}/upload.ps1"
                ],
                "options": {
                    "cwd": "${workspaceFolder:oled_sim}"
                },
                "problemMatcher": [],
                "group": "build"
            },
            {
                "label": "Firmware: build only (Ritual Machine)",
                "type": "shell",
                "command": "powershell",
                "args": [
                    "-NoProfile",
                    "-ExecutionPolicy",
                    "Bypass",
                    "-File",
                    "${workspaceFolder:oled_sim}/upload.ps1",
                    "-BuildOnly"
                ],
                "options": {
                    "cwd": "${workspaceFolder:oled_sim}"
                },
                "problemMatcher": [],
                "group": "build"
            },
            {
                "label": "Simulator: build",
                "type": "shell",
                "command": "powershell",
                "args": [
                    "-NoProfile",
                    "-ExecutionPolicy",
                    "Bypass",
                    "-File",
                    "${workspaceFolder:oled_sim}/build.ps1"
                ],
                "options": {
                    "cwd": "${workspaceFolder:oled_sim}"
                },
                "problemMatcher": [],
                "group": "build"
            },
            {
                "label": "Simulator: run",
                "type": "shell",
                "command": "powershell",
                "args": [
                    "-NoProfile",
                    "-ExecutionPolicy",
                    "Bypass",
                    "-File",
                    "${workspaceFolder:oled_sim}/run.ps1"
                ],
                "options": {
                    "cwd": "${workspaceFolder:oled_sim}"
                },
                "problemMatcher": []
            }
        ]
    }
}
